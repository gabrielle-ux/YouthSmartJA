-- ============================================

-- Example: jobs that mention Python in extracted skills
SELECT j.id, j.title, j.company
FROM jobs j
JOIN job_skills s ON s.job_id = j.id
WHERE s.skill = 'python'
ORDER BY j.id DESC
LIMIT 50;



-- Example: jobs requiring 5+ years (based on extracted experience strings)
SELECT j.id, j.title, j.company, e.experience
FROM jobs j
JOIN job_experience e ON e.job_id = j.id
WHERE e.experience LIKE '%5%'
ORDER BY j.id DESC
LIMIT 50;

