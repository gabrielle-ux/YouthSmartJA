-- ============================================
-- 4) CHILD TABLES: SKILLS / EXPERIENCE / CERTS / DEGREES
-- ============================================

-- Show skills rows (first 20)
SELECT j.title, s.skill
FROM jobs j
JOIN job_skills s ON s.job_id = j.id
ORDER BY j.id DESC
LIMIT 20;

-- Show experience rows (first 20)
SELECT j.title, e.experience
FROM jobs j
JOIN job_experience e ON e.job_id = j.id
ORDER BY j.id DESC
LIMIT 20;

-- Show certifications rows (first 20)
SELECT j.title, c.cert
FROM jobs j
JOIN job_certs c ON c.job_id = j.id
ORDER BY j.id DESC
LIMIT 20;

-- Show degrees rows (first 20)
SELECT j.title, d.degree
FROM jobs j
JOIN job_degrees d ON d.job_id = j.id
ORDER BY j.id DESC
LIMIT 20;



SELECT
    j.id,
    j.title,
    j.company,
    j.city,
    j.country,
    j.is_remote,
    j.salary_text,
    j.salary_min,
    j.salary_max,
    j.salary_currency,
    j.salary_period,
    LEFT(j.apply_link, 120) AS apply_link_preview,
    GROUP_CONCAT(DISTINCT s.skill ORDER BY s.skill SEPARATOR ', ') AS skills,
    GROUP_CONCAT(DISTINCT e.experience ORDER BY e.experience SEPARATOR ', ') AS experience,
    GROUP_CONCAT(DISTINCT c.cert ORDER BY c.cert SEPARATOR ', ') AS certifications,
    GROUP_CONCAT(DISTINCT d.degree ORDER BY d.degree SEPARATOR ', ') AS degrees
FROM jobs j
LEFT JOIN job_skills s ON s.job_id = j.id
LEFT JOIN job_experience e ON e.job_id = j.id
LEFT JOIN job_certs c ON c.job_id = j.id
LEFT JOIN job_degrees d ON d.job_id = j.id
GROUP BY j.id
ORDER BY j.id DESC
LIMIT 50;


SELECT
    id,
    student_id,
    user_id,
    filename,
    LENGTH(raw_text) AS text_length,
    LEFT(keywords, 150) AS keywords_preview,
    uploaded_at
FROM resumes
ORDER BY id DESC
LIMIT 20;

